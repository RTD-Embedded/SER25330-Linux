CC=gcc
DEBUG_FLAGS=
INCLUDE_FLAGS=-I../include
LIBRARY_FLAGS=-L../lib -lrtd-ser25330-gpio
OPTIMIZE_FLAGS=-O6
WARNING_FLAGS=-Wall
CFLAGS:=$(DEBUG_FLAGS) $(INCLUDE_FLAGS) $(OPTIMIZE_FLAGS) $(WARNING_FLAGS)

MY_CFLAGS := -I$(shell pwd)/../include -g

#
# Kernel build environment directory.  Supposedly it is safer to use this
# method of referring to it than using /usr/src.
#

KERNEL_DIR := /lib/modules/$(shell uname -r)/build

obj-m := exar_rtd.o

FILES_TO_CLEAN= \
	*.o \
	exar_rtd.ko \
	.*.cmd \
	*.ko \
	.tmp_versions \
	exar_rtd.mod.c \
	.*.d \
	*.symvers \
	*.order \
    *.markers \
	*~


all:	config-example-gpio

config-example-gpio:	config-example-gpio.o 
	$(CC) -g -o config-example-gpio config-example-gpio.o $(LIBRARY_FLAGS)


config-example-gpio.o:	config-example.c
	$(CC) -c -g $(CFLAGS) config-example.c -o config-example-gpio.o

clean:
	rm -rf *.o config-example-gpio


